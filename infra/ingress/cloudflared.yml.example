# Copy to ~/.config/bidfinder/cloudflared.yml outside Git.
# Create the named tunnel and DNS record in Cloudflare first.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /home/REPLACE_WITH_USER/.cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  # Never publish operator readiness or DB warm-up diagnostics.
  - hostname: public.example.com
    path: ^/(ready|api/warmup|docs|redoc|openapi\.json)(/.*)?$
    service: http_status:404
  - hostname: public.example.com
    service: http://127.0.0.1:8001
  - service: http_status:404
