# Runtime
ENV=production
PORT=8080
TRUST_PROXY_HEADERS=true

# Database
# Use the Neon pooled connection string for Cloud Run/serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_POOL_MAX_SIZE=4
DB_SSL_DISABLE=false

# Frontend / CORS
FRONTEND_URL=https://your-frontend.example.com
ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:3000,http://127.0.0.1:3000

# Access policy
ANONYMOUS_ACCESS_LEVEL=preview
ANONYMOUS_AUTOCOMPLETE_ENABLED=true
ANONYMOUS_METADATA_ENABLED=true
ANONYMOUS_FULL_QUERY_DAILY_LIMIT=10

# Rate limits
QUERY_RATE_LIMIT_PER_MINUTE=30
AUTOCOMPLETE_RATE_LIMIT_PER_MINUTE=120
PREVIEW_RATE_LIMIT_PER_MINUTE=90
METADATA_RATE_LIMIT_PER_MINUTE=20
FILTER_CONFIG_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=20

# Query/cache tuning
DEFAULT_QUERY_LIMIT=200
MAX_QUERY_LIMIT=1000
BULK_EXPORT_QUERY_LIMIT=1000
PREVIEW_CACHE_TTL_SECONDS=15
AUTOCOMPLETE_CACHE_TTL_SECONDS=20
CACHE_MAX_ENTRIES=500
STANDARD_QUERY_EXACT_COUNT_ENABLED=false

# Auth/session
AUTH_SESSION_COOKIE_NAME=bidfinder_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE_MODE=auto
AUTH_COOKIE_SAMESITE_MODE=auto
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_PASSWORD_MIN_LENGTH=9
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_RESET_URL_BASE=

# Google login
GOOGLE_CLIENT_ID=

# Email provider. Leave blank to disable password-reset email delivery.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=BIDFinder
AUTH_SMTP_USE_TLS=true
AUTH_SMTP_USE_SSL=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=BIDFinder
