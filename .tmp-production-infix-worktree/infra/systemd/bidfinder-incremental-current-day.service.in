[Unit]
Description=BIDFinder current-day incremental ingestion
Wants=network-online.target
After=network-online.target bidfinder-typesense.service

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/bidfinder/typesense.env
EnvironmentFile=-%h/.config/bidfinder/runtime.env
EnvironmentFile=-%h/.config/bidfinder/backend.env
EnvironmentFile=-%h/.config/bidfinder/api.env
Environment=BIDFINDER_REPO_ROOT=@BIDFINDER_REPO@
Environment=BIDFINDER_PYTHON=@BIDFINDER_VENV@/bin/python
Environment=BIDFINDER_INCREMENTAL_PROFILE=current-day
Environment=BIDFINDER_LOOKBACK_DAYS=0
WorkingDirectory=@BIDFINDER_REPO@
ExecStart=/usr/bin/env bash @BIDFINDER_REPO@/infra/runtime/bidfinder-incremental.sh
TimeoutStartSec=30m
Nice=10
StandardOutput=journal
StandardError=journal
